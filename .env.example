# ─────────────────────────────────────────────────────────────────────────────
# alfabetica-panel-webapp — environment variables
# Copy to `.env.local` for development. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of this panel (used for absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── panel-api connection (server only, never exposed to the browser) ─────────
# Base URL of alfabetica-panel-api. Required when any module runs in `real` mode.
# Local panel-api runs on PORT=4000 (see panel-api .env.example).
PANEL_API_URL=http://localhost:4000

# Default mode for every module: `mock` (in-memory simulated API) or `real` (proxy to PANEL_API_URL).
API_MODE=mock
# Per-module override (optional). Modules: AUTH, USERS, PROJECTS, PORTFOLIO, PUBLICATION, MEDIA, PRODUCTION, DASHBOARD.
# Note: AUTH decides who issues the access token; data modules in `real` mode need API_MODE_AUTH=real too.
# Demo mode = every module mock. As soon as one module is real, Resumen shows "Próximamente" (no GET /dashboard/summary
# in the API yet), Tienda leaves the navigation and the panel lands on Proyectos.
# Local panel-api (test environment), everything but Tienda and Resumen:
# API_MODE_AUTH=real
# API_MODE_USERS=real
# API_MODE_PROJECTS=real
# API_MODE_MEDIA=real
# API_MODE_PORTFOLIO=real
# API_MODE_PRODUCTION=real

# Mock auth only — simulated token lifetimes in seconds (mirror JWT_ACCESS_EXPIRES_IN=15m / JWT_REFRESH_EXPIRES_IN=12h).
MOCK_ACCESS_TOKEN_TTL=900
MOCK_REFRESH_TOKEN_TTL=43200

# ── Identity (Google sign-in) ────────────────────────────────────────────────
# `mock` = simulated sign-in with profile picker · `firebase` = Google via Firebase Auth.
NEXT_PUBLIC_AUTH_PROVIDER=mock
# Google Workspace domain hint for the account picker (must match panel-api ALLOWED_EMAIL_DOMAIN).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=alfabetica.com.mx

# Firebase web-app config (Firebase console → Project settings → Your apps → Web). Required with AUTH_PROVIDER=firebase.
# Same Firebase project as panel-api FIREBASE_SERVICE_ACCOUNT_B64. Public by design, but keep them in env.
# Also add localhost (and the panel domain) to Firebase Auth → Settings → Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Feature flags ────────────────────────────────────────────────────────────
# `false` shows the "Próximamente" screen in /tienda (future stage). `true` enables the full module.
NEXT_PUBLIC_FEATURE_STORE=false
